# Backend port
PORT=3001

# CORS origin (use * for hackathon, restrict in production)
CORS_ORIGIN=*

# ─── Mock toggles ────────────────────────────────────────────────────────────
# Set USE_MOCK_GENERATOR=false to call Toni's real generator at generator/.
# Set USE_MOCK_GITHUB=false to call Arnau's real github at backend/feature-packs/demo/.
# Defaults to "true" (mocks) so you can run the orchestrator standalone.
USE_MOCK_GENERATOR=true
USE_MOCK_GITHUB=true

# ─── Real generator (Toni) requires ──────────────────────────────────────────
# When USE_MOCK_GENERATOR=false:
#   - generator/.env must contain OPENAI_API_KEY (and optionally JUNIE_API_KEY)
#   - generator/node_modules must be installed (cd generator && npm install)

# ─── Real github (Arnau) requires ────────────────────────────────────────────
# When USE_MOCK_GITHUB=false you must set:
GITHUB_TOKEN=ghp_your_personal_access_token_with_repo_scope
GITHUB_USER=jetdev-demo
GITHUB_REPO=jetdev-demo
