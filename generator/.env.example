# OpenAI API key — for prompt enhancement + fallback code generation
OPENAI_API_KEY=sk-your-openai-key-here

# Junie API key — get it at https://junie.jetbrains.com/cli
# Optional: if not set, falls back to OpenAI for code generation
JUNIE_API_KEY=your-junie-key-here
#
# Windows: el paquete npm no instala el binario vía postinstall. Instala Junie con el
# script oficial (PowerShell) y deja JUNIE_API_KEY aquí. Ver: Junie CLI docs en jetbrains.com
